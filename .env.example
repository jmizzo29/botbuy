# Clerk — required for production beta auth. John: add keys in Vercel
# (Clerk Dashboard → API keys) before sign-in / sign-up work on prod.
# Do not invent keys. CI/`next build` passes through when these are empty;
# protected routes then fail closed (no DEMO_USER session).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional user.created / user.updated sync. Lazy resolve-on-request still works.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/intent

# Neon Postgres. Extend users.clerk_user_id via drizzle-kit push or
# drizzle/0001_clerk_user_id.sql on the direct (non-pooler) URL.
# App still seeds imported ledger from data/john-deal-ledger.json.
DATABASE_URL=

# CHO proof uses verified_at in code — do not invent public metrics
NEXT_PUBLIC_PROOF_STRIP_LIVE=false

# Set true only after Plausible or Vercel Analytics is connected
NEXT_PUBLIC_ANALYTICS_LIVE=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# No paid Stripe / Issuing in this POC. Public flag stays false.
NEXT_PUBLIC_STRIPE_LIVE=false

# Dedicated BotBuy Stripe/Link only. Never Autofleeto or STRIPE_SECRET_KEY.
# Restricted key (rk_) preferred over sk_. Server-only. Do not commit values.
# Without these, authorized-buy returns honest not-live. Card Available ≠ live.
BOTBUY_STRIPE_SECRET_KEY=
BOTBUY_STRIPE_PUBLISHABLE_KEY=
BOTBUY_STRIPE_WEBHOOK_SECRET=
# Must stay false until keys/wiring are CHO-proven. Scaffold still returns live: false.
BOTBUY_STRIPE_LIVE=false

# Canonical chrome is https://botbuyer.ai (DNS later)
NEXT_PUBLIC_APP_URL=https://botbuyer.ai

# Encrypted connector vault (Namecheap + Twilio + Shopify + HTTP JSON).
# 32-byte key as 64 hex chars. Server-only. Do not commit a real value.
BOTBUY_VAULT_KEY=

# Optional. Mutation tools (register/buy) never call provider HTTP unless true
# AND the deal was human-approved. Search/quote may HTTP if provider env exists.
BOTBUY_CONNECTORS_LIVE=false

# Optional Namecheap HTTP (not a public live connector)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# Do not invent IPs. UI copy: BotBuy will publish whitelist IPs.
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_SANDBOX=false

# Optional Twilio HTTP / OAuth (OAuth preferred; API key OK for POC)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_OAUTH_CLIENT_ID=
TWILIO_OAUTH_CLIENT_SECRET=
TWILIO_OAUTH_REDIRECT_URL=

# Optional Shopify Admin API / OAuth (merchant search · not a public live connector)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT_URL=

# Optional official HTTPS JSON API registry (MCP-style · not a browser farm)
HTTP_JSON_BASE_URL=
HTTP_JSON_BEARER_TOKEN=
