# BotBuyer native client — same product APIs as web. Soft HOLD.
# Copy to .env.local (gitignored). Do not invent or commit secrets.

# Staging Vercel alias (default in code if unset).
# Pretty host https://stage.botbuyer.ai is DNS-pending — do not assume it.
EXPO_PUBLIC_API_BASE=https://botbuy-git-staging-jmizzo29s-projects.vercel.app

# Clerk publishable key from the same BotBuyer Clerk app as web.
# Leave empty: keysConfigured=false · sign-in fail-closed (honest).
# Never put CLERK_SECRET_KEY here. Never prefix a secret with EXPO_PUBLIC_.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
